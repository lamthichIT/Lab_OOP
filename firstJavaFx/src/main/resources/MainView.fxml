<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">

    <!-- ================= CỘT TRÁI: QUẢN LÝ PLAYLIST & QUEUE ================= -->
    <left>
        <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: #1e1e1e; -fx-border-color: #2c2c2c; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
            </padding>

            <Label style="-fx-text-fill: #ffffff; -fx-font-size: 15px; -fx-font-weight: bold;" text="THƯ VIỆN MEDIA" />

            <!-- Cụm nút Mở file & Import/Export M3U8 -->
            <HBox spacing="6.0">
                <Button fx:id="openFileButton" maxWidth="Infinity" style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📂 Mở File" HBox.hgrow="ALWAYS" />
                <Button fx:id="importM3uButton" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand;" text="📥 Import .m3u8" />
                <Button fx:id="exportM3uButton" style="-fx-background-color: #333333; -fx-text-fill: white; -fx-cursor: hand;" text="📤 Export" />
            </HBox>

            <Separator style="-fx-background-color: #333333;" />

            <!-- Chọn và quản lý Playlist -->
            <Label style="-fx-text-fill: #b3b3b3; -fx-font-size: 12px;" text="Danh sách phát (Playlist):" />
            <ComboBox fx:id="playlistSelector" maxWidth="Infinity" promptText="Chọn Playlist..." style="-fx-background-color: #30F28E;" />

            <HBox spacing="6.0">
                <Button fx:id="newPlaylistButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;" text="➕ Tạo mới" />
                <Button fx:id="renamePlaylistButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;" text="✏ Đổi tên" />
                <Button fx:id="deletePlaylistButton" style="-fx-background-color: #8b2626; -fx-text-fill: white;" text="🗑 Xóa" />
            </HBox>

            <!-- 2 Tab: Danh sách gốc & Hàng đợi (Playback Queue) -->
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <tabs>
                    <Tab text="Danh sách bài">
                        <VBox spacing="6.0">
                            <padding><Insets top="6.0" /></padding>
                            <ListView fx:id="playlistListView" style="-fx-control-inner-background: #181818;" VBox.vgrow="ALWAYS">
                                <contextMenu>
                                    <ContextMenu>
                                        <items>
                                            <MenuItem fx:id="playNextMenuItem" text="⏭️ Phát tiếp theo (Play Next)" />
                                            <MenuItem fx:id="editMetadataMenuItem" text="✏️ Chỉnh sửa thông tin (Metadata)..." />
                                            <SeparatorMenuItem />
                                            <MenuItem fx:id="removeTrackMenuItem" text="🗑️ Xóa khỏi Playlist" />
                                        </items>
                                    </ContextMenu>
                                </contextMenu>
                            </ListView>
                            <HBox spacing="6.0">
                                <Button fx:id="addTrackToPlaylistButton" maxWidth="Infinity" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;" text="➕ Thêm bài vào Playlist" HBox.hgrow="ALWAYS" />
                            </HBox>
                        </VBox>
                    </Tab>

                    <Tab text="Hàng đợi">
                        <VBox spacing="6.0">
                            <padding><Insets top="6.0" /></padding>
                            <ListView fx:id="queueListView" style="-fx-control-inner-background: #181818;" VBox.vgrow="ALWAYS" />
                            <HBox alignment="CENTER" spacing="8.0">
                                <Button fx:id="moveUpQueueButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;" text="⬆ Lên" />
                                <Button fx:id="moveDownQueueButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white;" text="⬇ Xuống" />
                                <Button fx:id="removeFromQueueButton" style="-fx-background-color: #8b2626; -fx-text-fill: white;" text="❌ Xóa khỏi Queue" />
                            </HBox>
                        </VBox>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </left>

    <!-- ================= Ở GIỮA: MÀN HÌNH VIDEO / ẢNH BÌA NHẠC ================= -->
    <center>
        <StackPane fx:id="mediaContainer" style="-fx-background-color: #000000;">
            <!-- Lớp 1: Hiển thị khung hình Video từ vlcj -->
            <ImageView fx:id="videoImageView" preserveRatio="true" />

            <!-- Lớp 2: Hiển thị Ảnh bìa khi phát file Âm thanh (.mp3, .flac) -->
            <VBox fx:id="audioCoverPane" alignment="CENTER" spacing="15.0" visible="false">
                <ImageView fx:id="albumArtImageView" fitHeight="220.0" fitWidth="220.0" preserveRatio="true" />
                <Label fx:id="audioTitleLabel" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="Tên Bài Hát" />
                <Label fx:id="audioArtistLabel" style="-fx-text-fill: #b3b3b3; -fx-font-size: 15px;" text="Tên Nghệ Sĩ - Album" />
            </VBox>
        </StackPane>
    </center>

    <!-- ================= BÊN DƯỚI: THANH ĐIỀU KHIỂN (CONTROL BAR) ================= -->
    <bottom>
        <VBox spacing="8.0" style="-fx-background-color: #181818; -fx-border-color: #2c2c2c; -fx-border-width: 1 0 0 0;">
            <padding>
                <Insets bottom="12.0" left="20.0" right="20.0" top="10.0" />
            </padding>

            <!-- Hàng 1: Thanh tua (Seekbar) & Thời gian -->
            <HBox alignment="CENTER" spacing="12.0">
                <Label fx:id="currentTimeLabel" style="-fx-text-fill: #FFFFFF; -fx-font-family: monospace;" text="00:00" />
                <Slider fx:id="seekBar" style="-fx-cursor: hand;" HBox.hgrow="ALWAYS" />
                <Label fx:id="totalTimeLabel" style="-fx-text-fill: #b3b3b3; -fx-font-family: monospace;" text="00:00" />
            </HBox>

            <!-- Hàng 2: Cụm nút Điều khiển phát & Âm lượng -->
            <BorderPane>
                <!-- Góc trái: Thông tin nhanh bài đang phát -->
                <left>
                    <HBox alignment="CENTER_LEFT" prefWidth="250.0" spacing="10.0">
                        <Label fx:id="nowPlayingLabel" style="-fx-text-fill: #ffffff; -fx-font-weight: bold;" text="🎵 Chưa chọn tệp phát">
                     <font>
                        <Font size="14.0" />
                     </font></Label>
                    </HBox>
                </left>

                <!-- Chính giữa: Shuffle, Prev, Play/Pause, Next, Repeat -->
                <center>
                    <HBox alignment="CENTER" spacing="15.0">
                        <ToggleButton fx:id="shuffleToggleButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-cursor: hand;" text="🔀 Shuffle" />
                        <Button fx:id="prevButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-cursor: hand;" text="⏮ Prev" />
                        <Button fx:id="playPauseButton" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #1db954; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 20; -fx-cursor: hand;" text="▶ Play" />
                        <Button fx:id="nextButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-cursor: hand;" text="⏭ Next" />
                        <Button fx:id="repeatButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-cursor: hand;" text="🔁 Repeat: Off" />
                    </HBox>
                </center>

                <!-- Góc phải: Volume & Fullscreen -->
                <right>
                    <HBox alignment="CENTER_RIGHT" prefWidth="250.0" spacing="10.0">
                        <Label style="-fx-text-fill: white;" text="🔊">
                     <font>
                        <Font size="18.0" />
                     </font></Label>
                        <Slider fx:id="volumeSlider" max="100.0" prefWidth="100.0" value="80.0" />
                        <Button fx:id="fullscreenButton" style="-fx-background-color: #2a2a2a; -fx-text-fill: white; -fx-cursor: hand;" text="⛶ Fullscreen" />
                    </HBox>
                </right>
            </BorderPane>
        </VBox>
    </bottom>
</BorderPane>
